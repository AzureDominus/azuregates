{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Devices Configuration",
  "description": "Configuration schema for AzureGates devices (gates and utilities)",
  "type": "object",
  "required": ["version", "settings", "locations"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Configuration schema version"
    },
    "settings": {
      "type": "object",
      "required": ["defaultCooldownMs", "logLevel"],
      "properties": {
        "defaultCooldownMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 2000,
          "description": "Default cooldown between commands in milliseconds"
        },
        "logLevel": {
          "type": "string",
          "enum": ["fatal", "error", "warn", "info", "debug", "trace"],
          "default": "info"
        },
        "maintenanceMode": {
          "type": "boolean",
          "default": false,
          "description": "When true, all device commands are disabled"
        },
        "showStatusMessages": {
          "type": "boolean",
          "default": true,
          "description": "When true, show detailed status messages on device cards after commands"
        }
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Unique identifier for the location"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable name"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/area"
          }
        }
      }
    },
    "area": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device"
          }
        }
      }
    },
    "device": {
      "type": "object",
      "required": ["id", "name", "driver", "deviceType", "capabilities"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "deviceType": {
          "type": "string",
          "enum": ["gate", "utility"],
          "description": "Device type: gate for open/close/stop/toggle, utility for on/off/toggle"
        },
        "driver": {
          "type": "string",
          "enum": ["gpio", "webhook"]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["open", "close", "stop", "toggle", "on", "off", "state"]
          },
          "minItems": 0,
          "uniqueItems": true,
          "description": "Actions this device supports. For maintainState utilities, can be empty (on/off implicit)"
        },
        "config": {
          "oneOf": [
            { "$ref": "#/$defs/gpioConfig" },
            { "$ref": "#/$defs/webhookConfig" }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "gpioConfig": {
      "type": "object",
      "required": ["activeHigh"],
      "additionalProperties": false,
      "properties": {
        "openPin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "closePin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "stopPin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "togglePin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "onPin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40,
          "description": "GPIO pin for turning utility ON"
        },
        "offPin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40,
          "description": "GPIO pin for turning utility OFF (if different from onPin)"
        },
        "pulseDurationMs": {
          "type": "integer",
          "minimum": 50,
          "maximum": 60000,
          "default": 500,
          "description": "Duration for toggle/pulse operations (ms)"
        },
        "holdDurationMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000,
          "description": "Duration to hold the pin active for open/close operations (ms). Used for gates that move while pin is held low/high."
        },
        "maintainState": {
          "type": "boolean",
          "default": false,
          "description": "If true, the relay stays on until explicitly turned off. If false, uses pulse/hold durations."
        },
        "activeHigh": {
          "type": "boolean",
          "default": false,
          "description": "If true, pin is HIGH when active. If false, pin is LOW when active (relay closes on low)."
        }
      }
    },
    "webhookConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoints": {
          "type": "object",
          "properties": {
            "open": { "type": "string", "format": "uri" },
            "close": { "type": "string", "format": "uri" },
            "stop": { "type": "string", "format": "uri" },
            "toggle": { "type": "string", "format": "uri" },
            "on": { "type": "string", "format": "uri" },
            "off": { "type": "string", "format": "uri" },
            "state": { "type": "string", "format": "uri" }
          }
        },
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "actionParam": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT"],
          "default": "POST"
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000,
          "default": 5000
        }
      }
    }
  }
}
