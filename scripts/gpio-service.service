[Unit]
Description=AzureGates GPIO Service
After=network.target

[Service]
Type=notify
User=root
Group=gpio
WorkingDirectory=/opt/gates/scripts

# Install dependencies first, then run Python directly with venv
ExecStartPre=/home/pi/.local/bin/uv sync --frozen
ExecStart=/opt/gates/scripts/.venv/bin/python gpio_service.py --port 5000 --host 0.0.0.0

# Watchdog - service pings every 30s, timeout at 60s
WatchdogSec=60
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gpio-service

[Install]
WantedBy=multi-user.target
