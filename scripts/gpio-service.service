[Unit]
Description=AzureGates GPIO Service
After=network.target

[Service]
Type=simple
User=root
Group=gpio
WorkingDirectory=/opt/gates/scripts
# Use uv run to manage the Python environment
ExecStart=/home/pi/.local/bin/uv run gpio_service.py --port 5000 --host 0.0.0.0
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gpio-service

[Install]
WantedBy=multi-user.target
