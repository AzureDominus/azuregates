[Unit]
Description=AzureGates GPIO Service
After=network.target

[Service]
Type=notify
User=root
Group=gpio
WorkingDirectory=/opt/gates/scripts
ExecStart=/usr/bin/python3 /opt/gates/scripts/gpio_service.py --port 5000 --host 0.0.0.0
Restart=always
RestartSec=5
WatchdogSec=60

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gpio-service

[Install]
WantedBy=multi-user.target
