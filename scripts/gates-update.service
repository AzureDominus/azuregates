[Unit]
Description=Gates Application Auto-Update Service
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/gates/scripts/update.sh
WorkingDirectory=/opt/gates
User=root
StandardOutput=journal
StandardError=journal

# Timeout for the update process (10 minutes should be plenty)
TimeoutStartSec=600

# Environment file for any needed variables
EnvironmentFile=-/opt/gates/.env

[Install]
WantedBy=multi-user.target
