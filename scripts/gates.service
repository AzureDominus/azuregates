[Unit]
Description=AzureGates Docker Compose Stack
Documentation=https://github.com/AzureDominus/azuregates
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/gates

# Start the stack with remote-access profile, follow logs to keep service running
ExecStartPre=/usr/bin/docker compose --profile remote-access up -d --remove-orphans --wait
ExecStart=/usr/bin/docker compose --profile remote-access logs -f
ExecStop=/usr/bin/docker compose --profile remote-access down
ExecReload=/usr/bin/docker compose --profile remote-access up -d --remove-orphans

# Restart policy
Restart=on-failure
RestartSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gates

# Give containers time to start and stop
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
