# Production Caddy Configuration for Gates Application
# Supports both local access via mDNS and optional remote access via Cloudflare

{
    # Enable admin API for health checks
    admin :2019

    # Production settings
    email {$ACME_EMAIL:admin@localhost}
    
    # For local-only deployment without Let's Encrypt
    # Uncomment the following line if not using HTTPS
    # auto_https off
}

# Local access via mDNS hostname and custom domain (via Cloudflare Tunnel)
# CUSTOM_DOMAIN env var enables remote access, e.g., CUSTOM_DOMAIN=gates.aztelar.com
gates.local, garagepi.local, localhost, {$HOSTNAME:gates.home}, {$CUSTOM_DOMAIN:_.disabled} {
    # Use self-signed cert for local HTTPS (Cloudflare handles public SSL via tunnel)
    tls internal

    # Backend API
    handle /api/* {
        reverse_proxy backend:3001 {
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        }
    }

    # Authentik authentication - strip /auth prefix and forward to Authentik root
    handle_path /auth/* {
        reverse_proxy authentik:9000 {
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        }
    }

    # Authentik outpost (if using forward auth)
    handle /outpost.goauthentik.io/* {
        reverse_proxy authentik:9000
    }

    # Health check
    handle /health {
        reverse_proxy backend:3001
    }

    # Frontend (production nginx serving built files)
    handle {
        reverse_proxy frontend:80
    }

    # Security headers
    header {
        # Prevent XSS
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        # CSP - adjust as needed
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }

    # Logging
    log {
        output stdout
        format json
        level INFO
    }
}


