# Production Caddy Configuration for Gates Application
# Supports both local access via mDNS and remote access via Cloudflare Tunnel

{
    # Enable admin API for health checks
    admin :2019

    # Production settings
    email {$ACME_EMAIL:admin@localhost}
}

# HTTP-only for Cloudflare Tunnel (tunnel handles SSL termination)
# The :80 prefix creates an HTTP-only listener without auto-HTTPS redirect
:80 {
    # Only respond to requests with the custom domain or Cloudflare headers
    @cloudflare {
        header Cf-Ray *
    }
    @local {
        not header Cf-Ray *
    }

    # Redirect local HTTP to HTTPS
    handle @local {
        redir https://{host}{uri} permanent
    }

    # Handle Cloudflare tunnel requests (already SSL terminated)
    handle @cloudflare {
        # Backend API
        handle /api/* {
            reverse_proxy backend:3001 {
                header_up X-Real-IP {http.request.header.CF-Connecting-IP}
            }
        }

        # Authentik authentication - strip /auth prefix
        handle_path /auth/* {
            reverse_proxy authentik:9000 {
                header_up X-Real-IP {http.request.header.CF-Connecting-IP}
            }
        }

        # Authentik outpost
        handle /outpost.goauthentik.io/* {
            reverse_proxy authentik:9000
        }

        # Health check
        handle /health {
            reverse_proxy backend:3001
        }

        # Frontend
        handle {
            reverse_proxy frontend:80
        }

        # Security headers
        header {
            X-Content-Type-Options nosniff
            X-Frame-Options DENY
            Referrer-Policy strict-origin-when-cross-origin
            Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data:; connect-src 'self' https://api.iconify.design; worker-src 'self' blob:; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com data:"
        }
    }

    log {
        output stdout
        format json
        level INFO
    }
}

# HTTPS for local mDNS access (self-signed certs)
# LOCAL_HOSTS can be set to customize hostnames (comma-separated)
# Example: LOCAL_HOSTS=gates.local,garagepi.local,myhome.local
{$LOCAL_HOSTS:gates.local, garagepi.local, localhost} {
    tls internal

    # Backend API
    handle /api/* {
        reverse_proxy backend:3001
    }

    # Authentik authentication - strip /auth prefix
    handle_path /auth/* {
        reverse_proxy authentik:9000
    }

    # Authentik outpost
    handle /outpost.goauthentik.io/* {
        reverse_proxy authentik:9000
    }

    # Health check
    handle /health {
        reverse_proxy backend:3001
    }

    # Frontend
    handle {
        reverse_proxy frontend:80
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data:; connect-src 'self' https://api.iconify.design; worker-src 'self' blob:; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com data:"
    }

    log {
        output stdout
        format json
        level INFO
    }
}


