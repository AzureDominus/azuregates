{
  "name": "gates-backend",
  "version": "0.1.0",
  "type": "module",
  "description": "Garage Gate Opener v2 - Backend API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/session": "^11.0.2",
    "@prisma/client": "^6.9.0",
    "@types/connect-redis": "^0.0.23",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "connect-redis": "^9.0.0",
    "fastify": "^5.6.2",
    "js-yaml": "^4.1.0",
    "openid-client": "^6.5.1",
    "pino": "^9.8.0",
    "pino-pretty": "^13.0.0",
    "redis": "^5.10.0",
    "zod": "^3.25.60"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.27.0",
    "prisma": "^6.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
