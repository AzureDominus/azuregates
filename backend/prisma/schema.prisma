generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users (mapped from Authentik by external ID)
model User {
  id          String   @id @default(cuid())
  externalId  String   @unique @map("external_id")
  email       String?
  displayName String?  @map("display_name")
  isAdmin     Boolean  @default(false) @map("is_admin")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Account activation - new accounts require admin approval
  // isActivated: false = account pending approval or disabled
  // activatedAt: set when first approved (never cleared on deactivation)
  // activatedBy: user ID of admin who approved (for audit trail)
  isActivated Boolean   @default(false) @map("is_activated")
  activatedAt DateTime? @map("activated_at")
  activatedBy String?   @map("activated_by")

  // Relations
  permissions   UserPermission[]
  invitesCreated Invite[]        @relation("InviteCreator")
  auditLogs     AuditLog[]

  @@map("users")
}

// Locations (homes)
model Location {
  id        String   @id
  name      String
  enabled   Boolean  @default(true)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  areas Area[]

  @@map("locations")
}

// Areas within a location
model Area {
  id         String   @id
  locationId String   @map("location_id")
  name       String
  enabled    Boolean  @default(true)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  devices  Device[]

  @@map("areas")
}

// Devices (controllable units - gates and utilities)
model Device {
  id           String   @id
  areaId       String   @map("area_id")
  name         String
  enabled      Boolean  @default(true)
  deviceType   String   @default("gate") @map("device_type")
  driverType   String   @map("driver_type")
  driverConfig Json     @default("{}") @map("driver_config")
  capabilities String[]
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  area      Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@map("devices")
}

// User permissions (including guest access)
model UserPermission {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  scopeType  ScopeType @map("scope_type")
  scopeId    String    @map("scope_id")
  actions    String[]
  expiresAt  DateTime? @map("expires_at")
  grantedBy  String?   @map("granted_by")
  inviteId   String?   @map("invite_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invite Invite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([scopeType, scopeId])
  @@map("user_permissions")
}

enum ScopeType {
  LOCATION
  AREA
  DEVICE
}

// Invites for guest access
model Invite {
  id             String    @id @default(cuid())
  tokenHash      String    @unique @map("token_hash")
  createdById    String    @map("created_by_id")
  scopeType      ScopeType @map("scope_type")
  scopeId        String    @map("scope_id")
  allowedActions String[]  @map("allowed_actions")
  expiresAt      DateTime  @map("expires_at")
  maxUses        Int?      @map("max_uses")
  useCount       Int       @default(0) @map("use_count")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relations
  createdBy   User             @relation("InviteCreator", fields: [createdById], references: [id])
  permissions UserPermission[]

  @@map("invites")
}

// Audit log for all command attempts
model AuditLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  deviceId     String?  @map("device_id")
  action       String
  result       String   // 'success' | 'failure' | 'denied'
  errorMessage String?  @map("error_message")
  clientIp     String?  @map("client_ip")
  userAgent    String?  @map("user_agent")
  latencyMs    Int?     @map("latency_ms")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([createdAt])
  @@map("audit_logs")
}
