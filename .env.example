# Gates Application Environment Variables
# Copy this file to .env and fill in the values for your environment

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL password (use a strong password in production)
POSTGRES_PASSWORD=your-secure-password-here

# =============================================================================
# SESSION & SECURITY
# =============================================================================
# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your-session-secret-min-32-chars

# =============================================================================
# AUTHENTIK (Identity Provider)
# =============================================================================
# Authentik secret key (generate with: openssl rand -base64 60)
AUTHENTIK_SECRET_KEY=your-authentik-secret-key-min-50-chars

# OAuth2/OIDC client credentials (created in Authentik admin panel)
AUTHENTIK_CLIENT_ID=azure-gates
AUTHENTIK_CLIENT_SECRET=your-oauth-client-secret

# Authentik application slug (must match the application name in Authentik)
AUTHENTIK_SLUG=azure-gates

# Authentik admin group name (users in this group get admin access)
AUTHENTIK_ADMIN_GROUP=gates-admin

# External URL for Authentik (used for OAuth redirects)
# For local access: http://gates.local/auth
# For remote access: https://your-domain.com/auth
AUTHENTIK_EXTERNAL_URL=http://gates.local/auth

# =============================================================================
# APPLICATION
# =============================================================================
# Application URL (used for OAuth redirects)
# For local access: http://gates.local
# For remote access: https://your-domain.com
BASE_URL=http://gates.local

# Logging level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Config file to use (relative to /app/config)
# Development: gates.yaml
# Production: gates.prod.yaml
GATES_CONFIG_FILE=gates.prod.yaml

# Docker image version tag (latest, main, v1.0.0, etc.)
GATES_VERSION=latest

# =============================================================================
# REMOTE ACCESS (Optional)
# =============================================================================
# Cloudflare Tunnel token (only if using remote access)
# Get this from Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=

# Custom domain (if using remote access via Cloudflare)
CUSTOM_DOMAIN=

# =============================================================================
# UPDATES & NOTIFICATIONS (Optional)
# =============================================================================
# Notification URL for Watchtower auto-updates
# Examples: telegram://token@telegram?chats=@channel-1
NOTIFICATION_URL=

# ACME email for Let's Encrypt (if using public HTTPS)
ACME_EMAIL=admin@example.com
