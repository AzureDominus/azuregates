# Gates Application Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL
POSTGRES_PASSWORD=your-secure-password-here

# Session (generate with: openssl rand -hex 32)
SESSION_SECRET=your-session-secret-min-32-chars

# Authentik
AUTHENTIK_SECRET_KEY=your-authentik-secret-key-min-50-chars
AUTHENTIK_CLIENT_ID=gates
AUTHENTIK_CLIENT_SECRET=your-oauth-client-secret

# Application URL (used for OAuth redirects)
# For local access: http://gates.local
# For remote access: https://your-domain.com
BASE_URL=http://gates.local

# Logging level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Cloudflare Tunnel token (only if using remote access)
# Get this from Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=

# Notification URL for Watchtower auto-updates (optional)
# Examples: telegram://token@telegram?chats=@channel-1
NOTIFICATION_URL=

# ACME email for Let's Encrypt (if using public HTTPS)
ACME_EMAIL=admin@example.com

# Custom domain (if using remote access via Cloudflare)
CUSTOM_DOMAIN=
